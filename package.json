    "mx": "tsx .claude/skills/website-lead-enrichment/subskills/resolve-email-domains/scripts/resolve-email-domains.ts",
    "learn": "tsx .claude/skills/website-lead-enrichment/subskills/learn-email-patterns/scripts/learn-email-patterns.ts",
