{
  "name": "vertical-saas-agent",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Vertical-SaaS lead-gen agent: company websites -> team members + emails (scrape, harvest, Codex web-discovery, MX + pattern-learning + permutation).",
  "keywords": [
    "lead-generation",
    "email-finder",
    "web-scraping",
    "agent-skill",
    "claude-code",
    "codex",
    "sales",
    "prospecting",
    "b2b"
  ],
  "homepage": "https://github.com/Lexdash-org/vertical-saas-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexdash-org/vertical-saas-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Lexdash-org/vertical-saas-agent/issues"
  },
  "author": "Lexdash",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "rank": "tsx skills/website-lead-enrichment/scripts/discover-team-pages/rank-batch.ts",
    "extract": "tsx skills/website-lead-enrichment/scripts/extract-team-members/run-batch.ts",
    "harvest": "tsx skills/website-lead-enrichment/scripts/harvest-business-emails/harvest-business-emails.ts",
    "harvest:related": "tsx skills/website-lead-enrichment/scripts/recover-related-emails/harvest-related.ts",
    "harvest:render": "tsx skills/website-lead-enrichment/scripts/recover-related-emails/harvest-render.ts",
    "websearch": "tsx skills/website-lead-enrichment/scripts/discover-web-emails/enrich-web-search.ts",
    "usage": "tsx skills/website-lead-enrichment/scripts/discover-web-emails/codex-usage-check.ts",
    "mx": "tsx skills/website-lead-enrichment/scripts/resolve-email-domains/resolve-email-domains.ts",
    "learn": "tsx skills/website-lead-enrichment/scripts/learn-email-patterns/learn-email-patterns.ts",
    "permute": "tsx skills/website-lead-enrichment/scripts/email-permutation/apply-permutation.ts",
    "doctor": "tsx skills/website-lead-enrichment/scripts/doctor/doctor.ts",
    "test": "tsx --test skills/website-lead-enrichment/scripts/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && tsx .github/scripts/validate-skills.ts . && tsx .github/scripts/check-invariants.ts && tsx .github/scripts/run-evals.ts",
    "evals": "tsx .github/scripts/run-evals.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.114",
    "@mastra/core": "0.24.9",
    "dotenv": "17.4.2",
    "firecrawl": "4.30.1",
    "openai": "5.23.2",
    "p-limit": "3.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
