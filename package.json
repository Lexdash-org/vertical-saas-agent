    "harvest:related": "tsx .claude/skills/website-lead-enrichment/subskills/recover-related-emails/scripts/harvest-related.ts",
    "harvest:render": "tsx .claude/skills/website-lead-enrichment/subskills/recover-related-emails/scripts/harvest-render.ts",
    "websearch": "tsx .claude/skills/website-lead-enrichment/subskills/discover-web-emails/scripts/enrich-web-search.ts",
