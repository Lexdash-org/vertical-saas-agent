# Secrets — real keys live here (never committed). See .env.example.
.env

# Deps & build
node_modules/
dist/
*.tsbuildinfo

# Working data. Real runs contain named individuals and their email addresses, so
# nothing the pipeline produces is committed. The shippable sample input and output
# both live in examples/ and are committed deliberately.
out/
# any scratch output dir from a test run (out-clinics/, out-test/, ...)
out-*/
ENRICHED-team-emails.csv

# Lead lists are commercial assets and contain business contact data — keep them local.
# Anchored to data/ only; examples/ is committed on purpose.
data/*.csv

# OS / logs / caches
.DS_Store
logs/

# Remotion project deps + render cache
marketing/remotion-post/node_modules/
marketing/out/check-*.png
