# Copy to .env and fill in. The real .env is gitignored (secrets stay local).

# --- Scraping (required) ---
FIRECRAWL_API_KEY=fc-...           # site URL mapping, stage 1 only (firecrawl.com)
ZYTE_API_KEY=...                   # every page fetch, stages 2-4 (zyte.com)

# --- LLM (required) ---
# Any OpenAI-compatible endpoint. Two roles; point both at one model if you prefer.
#   reasoning  = ranks pages, judges ambiguous email formats
#   extraction = pulls {name, title, email} out of page text
LLM_API_KEY=...
LLM_BASE_URL=                      # omit for api.openai.com; else the provider's base URL
LLM_MODEL_REASONING=gpt-4o
LLM_MODEL_EXTRACTION=gpt-4o-mini

# Examples:
#   OpenAI      LLM_BASE_URL=            (leave empty)
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Together    LLM_BASE_URL=https://api.together.xyz/v1
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama

# --- Azure OpenAI preset (alternative to the four LLM_* vars above) ---
# The validated defaults. Set these INSTEAD of LLM_* and everything works unchanged.
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_OPENAI_DEPLOYMENT_SOL=gpt-5.6-sol      # reasoning
# AZURE_OPENAI_DEPLOYMENT_LUNA=gpt-5.6-luna    # extraction

# --- Open-web discovery (OPTIONAL — stage 5 is skippable) ---
# Codex is NOT required. Without it, stage 5 is skipped and the rest runs normally.
# Codex uses the ChatGPT login (run `codex login`), NOT an API key here.
# IMPORTANT: keep OPENAI_API_KEY UNSET — the runner unsets it so codex uses the subscription.
CODEX_BIN=codex                    # optional; resolved from PATH by default
CODEX_MODEL=gpt-5.6-sol            # optional

# --- Paths (optional) ---
# LEADGEN_ROOT=/path/to/project    # when the skill is installed outside this repo
# LEADGEN_OUT_DIR=/path/to/out     # redirect pipeline state, e.g. for a test run
