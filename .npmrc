# Required, not a convenience. Without it `npm install` fails with ERESOLVE:
# firecrawl ships zod@3 while this project uses zod@4, and @ai-sdk/react
# (via @mastra/core -> ai) peer-requires zod@^3.23.8. The two resolve fine at
# runtime — they are separate installs, not a shared singleton — but npm's
# strict peer resolution refuses to proceed.
#
# Remove this only after firecrawl and the ai-sdk agree on a zod major.
legacy-peer-deps=true
