# Required, not a convenience. Without it `npm install` fails with ERESOLVE:
# firecrawl ships zod@3 while this project uses zod@4, and @ai-sdk/react
# (via @mastra/core -> ai) peer-requires zod@^3.23.8. The two resolve fine at
# runtime — they are separate installs, not a shared singleton — but npm's
# strict peer resolution refuses to proceed.
#
# Remove this only after firecrawl and the ai-sdk agree on a zod major.
legacy-peer-deps=true

# Deliberately NOT silencing `npm audit` here. An earlier version set audit=false on the
# grounds that the advisories were unreachable transitive deps — that was wrong: `npm audit`
# reports 5 high, and they trace through `@mastra/core` and `@ai-sdk/provider-utils`, both
# direct runtime imports of the extraction stage. Silencing at the root would have hidden
# them from maintainers and CI to spare one audience the noise. The install doc passes
# `--no-audit --no-fund` on its own command line instead, which is where that audience is.
